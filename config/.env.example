# ── Snowflake ─────────────────────────────────────────────────
SNOWFLAKE_ACCOUNT=your_account.us-east-1
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_WAREHOUSE=DE_WH
SNOWFLAKE_DATABASE_DEV=DE_AI_AGENT_DEV
SNOWFLAKE_DATABASE_PROD=DE_AI_AGENT_PROD
SNOWFLAKE_INGEST_ROLE=DE_INGEST_ROLE
SNOWFLAKE_TRANSFORM_ROLE=DE_TRANSFORM_ROLE
SNOWFLAKE_SERVING_ROLE=DE_SERVING_ROLE

# ── Environment ───────────────────────────────────────────────
# "dev" or "prod" — controls which Snowflake database dbt targets
DBT_TARGET=dev

# ── Groq ──────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=1024

# ── FastAPI ───────────────────────────────────────────────────
API_KEY=generate_a_strong_random_key_here
API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_ORIGIN=http://localhost:8501

# ── Slack ─────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
SLACK_ALERTS_ENABLED=true

# ── Prefect ───────────────────────────────────────────────────
PREFECT_API_URL=http://localhost:4200/api

# ── Paths (override defaults only if needed) ──────────────────
# SQLITE_DB_PATH=~/AI_Projects/de-ai-agent/data/products.db
# SUPERSTORE_CSV_PATH=~/AI_Projects/de-ai-agent/data/superstore_sales.csv
# CHROMA_PERSIST_DIR=~/AI_Projects/de-ai-agent/.chroma
