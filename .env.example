# DuckDB (current backend)
DUCKDB_PATH=./data/fifa.duckdb

# Snowflake connection (legacy)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_DATABASE=DE_AI_AGENT_DEV
SNOWFLAKE_SCHEMA=BRONZE
SNOWFLAKE_WAREHOUSE=DE_WH
SNOWFLAKE_ROLE=DE_INGEST_ROLE

# dbt
DBT_TARGET=dev
DBT_PROJECT_DIR=./dbt_project

# Ollama (local LLM)
OLLAMA_MODEL=qwen2.5-coder:14b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434

# FastAPI
API_KEY=

# Optional: Slack alerts
SLACK_WEBHOOK_URL=

# Optional: GitHub PR automation
GITHUB_TOKEN=
